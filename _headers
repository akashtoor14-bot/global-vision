# Cloudflare Pages response headers.
# Pages (HTML) keep the default "always re-check" so edits show up at once.
# Fonts never change under the same name: cache for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images can be replaced under the same name, so cache for a week and
# refresh quietly in the background after that.
/*.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/headshots/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
